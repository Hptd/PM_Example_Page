<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.pm.mapper.PmProjectMapper">

    <resultMap type="PmProject" id="PmProjectResult">
        <id     property="id"          column="id"           />
        <result property="ownerId"     column="owner_id"     />
        <result property="name"        column="name"         />
        <result property="description" column="description"  />
        <result property="cover"       column="cover"        />
        <result property="content"     column="content"      />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <resultMap type="PmProjectVersion" id="PmProjectVersionResult">
        <id     property="id"         column="id"          />
        <result property="projectId"  column="project_id"  />
        <result property="version"    column="version"     />
        <result property="content"    column="content"     />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectPmProjectVo">
        select id, owner_id, name, description, cover, content,
               create_by, create_time, update_by, update_time, remark
        from pm_project
    </sql>

    <select id="selectPmProjectList" parameterType="PmProject" resultMap="PmProjectResult">
        <include refid="selectPmProjectVo"/>
        <where>
            del_flag = '0'
            <if test="name != null and name != ''">
                and name like concat('%', #{name}, '%')
            </if>
            <if test="ownerId != null">
                and owner_id = #{ownerId}
            </if>
        </where>
        order by update_time desc
    </select>

    <select id="selectPmProjectById" parameterType="Long" resultMap="PmProjectResult">
        <include refid="selectPmProjectVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <insert id="insertPmProject" parameterType="PmProject" useGeneratedKeys="true" keyProperty="id">
        insert into pm_project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ownerId != null">owner_id,</if>
            <if test="name != null">name,</if>
            <if test="description != null">description,</if>
            <if test="cover != null">cover,</if>
            <if test="content != null">content,</if>
            <if test="createBy != null">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ownerId != null">#{ownerId},</if>
            <if test="name != null">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="cover != null">#{cover},</if>
            <if test="content != null">#{content},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updatePmProject" parameterType="PmProject">
        update pm_project
        <trim prefix="SET" suffixOverrides=",">
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="content != null">content = #{content},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <update id="deletePmProjectById" parameterType="Long">
        update pm_project set del_flag = '2' where id = #{id}
    </update>

    <update id="deletePmProjectByIds" parameterType="Long">
        update pm_project set del_flag = '2' where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <insert id="insertPmProjectVersion" parameterType="PmProjectVersion" useGeneratedKeys="true" keyProperty="id">
        insert into pm_project_version (project_id, version, content, create_by, create_time)
        values (#{projectId}, #{version}, #{content}, #{createBy}, sysdate())
    </insert>

    <select id="selectPmProjectVersions" parameterType="Long" resultMap="PmProjectVersionResult">
        select id, project_id, version, content, create_by, create_time
        from pm_project_version
        where project_id = #{projectId}
        order by version desc
    </select>
</mapper>
